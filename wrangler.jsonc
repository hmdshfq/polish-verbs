// Cloudflare Workers: the site in dist/ as static assets, one Worker script in
// worker/, and D1 for the progress that follows a learner between devices.
// `npm run deploy` builds dist/ and uploads the lot.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "polish-verbs",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  // A matching asset is served before the Worker runs, so pages stay free and
  // only /api/progress and unknown paths reach worker/index.js.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* needs the Worker; every other path, a 404 included, is
    // answered by the asset server without an invocation.
    "run_worker_first": ["/api/*"]
  },

  // Sync failures are logged as structured JSON; keep them where they can be
  // queried in the dashboard, and trace the requests that reach the API.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true },
    "traces": { "enabled": true }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polski-verbs-progress",
      "database_id": "b3524eeb-0c85-4af4-b60a-9ad973f30e46"
    }
  ]
}
