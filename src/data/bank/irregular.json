  {
    "id": "knowing",
    "title": "wiedzieć, znać, umieć",
    "ask": "Which kind of knowing?",
    "items": [
      { "id": "irr-9", "kind": "choice", "q": "\"I know where the station is.\" Which verb?",
        "opts": ["wiedzieć", "znać", "umieć", "być"], "a": "wiedzieć",
        "why": "<span class=\"pl\">Wiem, gdzie jest dworzec.</span> — a fact. <span class=\"pl\">wiedzieć</span> takes a clause or <span class=\"pl\">o</span> + locative: <span class=\"pl\">wiem o tym</span>." },
      { "id": "irr-10", "kind": "choice", "q": "\"I know Łódź well.\" Which verb?",
        "opts": ["znać", "wiedzieć", "umieć", "mieszkać"], "a": "znać",
        "why": "<span class=\"pl\">Znam Łódź dobrze.</span> — familiarity with a place, a person or a language. <span class=\"pl\">Znam</span> takes a plain accusative object." },
      { "id": "irr-11", "kind": "choice", "q": "\"I can swim.\" Which verb?",
        "opts": ["umieć", "móc", "wiedzieć", "znać"], "a": "umieć",
        "why": "<span class=\"pl\">Umiem pływać.</span> — a learnt skill. <span class=\"pl\">Móc</span> is about possibility or permission: <span class=\"pl\">Czy mogę wejść?</span> — may I come in?" },
      { "id": "irr-12", "kind": "type", "q": "<span class=\"pl\">wiedzieć</span> — <i>ja</i>", "accept": ["wiem"],
        "why": "<span class=\"pl\">wiem</span> — the present stem is <span class=\"pl\">wiem-</span>, not <span class=\"pl\">wiedz-</span>." },
      { "id": "irr-13", "kind": "type", "q": "<span class=\"pl\">wiedzieć</span> — <i>oni / one</i>", "accept": ["wiedzą"],
        "why": "<span class=\"pl\">wiedzą</span> — here the <span class=\"pl\">dz</span> is back, and with <span class=\"pl\">-ą</span>." },
      { "id": "irr-14", "kind": "choice", "q": "\"Do you know Polish?\" Which?",
        "opts": ["Znasz polski?", "Wiesz polski?", "Umiesz polskiego?", "Znasz po polsku?"], "a": "Znasz polski?",
        "why": "A language is something you <i>znasz</i>, and the object is accusative: <span class=\"pl\">Znasz polski?</span> For a skill you use <span class=\"pl\">umieć</span>: <span class=\"pl\">Umiem mówić po polsku</span>." }
    ]
  },
