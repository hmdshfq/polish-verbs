      { "id": "irr-2", "kind": "type", "q": "<span class=\"pl\">być</span> — <i>ty</i>", "accept": ["jesteś"],
        "why": "<span class=\"pl\">jesteś</span>." },
      { "id": "irr-3", "kind": "type", "q": "<span class=\"pl\">być</span> — <i>on / ona / ono</i>", "accept": ["jest"],
        "why": "<span class=\"pl\">jest</span> — one short word. Polish does not leave it out the way Russian does: <span class=\"pl\">To jest dom</span>." },
      { "id": "irr-4", "kind": "type", "q": "<span class=\"pl\">być</span> — <i>my</i>", "accept": ["jesteśmy"],
