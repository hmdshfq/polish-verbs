      { "lv": "jeść", "p": "present / past", "m": "jem, jesz… jedzą / jadłem, jedli", "ex": "Jem obiad." },
      { "lv": "pić", "p": "present / past", "m": "piję, pijesz… / piłem, pili", "ex": "Piję kawę." },
      { "lv": "wziąć", "p": "future / past", "m": "wezmę, weźmiesz… / wziąłem, wzięłam", "ex": "Wezmę to." },
      { "lv": "brać", "p": "present", "m": "biorę, bierzesz, bierze…", "ex": "Biorę to." },
      { "lv": "móc", "p": "present / past", "m": "mogę, możesz… / mogłem, mogłam", "ex": "Mogę pomóc." },
      { "lv": "chcieć", "p": "present / past", "m": "chcę, chcesz… / chciałem, chciałam", "ex": "Chcę kawę." },
      { "lv": "wiedzieć", "p": "present", "m": "wiem, wiesz, wie, wiemy, wiecie, wiedzą", "ex": "Wiem, gdzie to jest." },
      { "lv": "znać", "p": "present", "m": "znam, znasz, zna, znamy, znacie, znają", "ex": "Znam Łódź." }
