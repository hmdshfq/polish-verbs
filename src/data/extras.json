      { "lv": "instrumental", "p": "być / zostać", "m": "instrumental for a profession", "ex": "Jestem programistą." },
      { "lv": "instrumental", "p": "interesować się", "m": "interesować się + instrumental", "ex": "Interesuję się historią." },
      { "lv": "preposition", "p": "czekać na", "m": "czekać na + accusative", "ex": "Czekam na autobus." },
