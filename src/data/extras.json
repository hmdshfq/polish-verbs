    "plan": [
      { "t": "Day 1 · być", "items": [
        { "k": "irr-d1-a", "en": "Learn the three roots: jest- (present), by- (past), będ- (future)." },
        { "k": "irr-d1-b", "en": "Do the drills: byc." }
      ]},
      { "t": "Day 2 · mieć and dać", "items": [
        { "k": "irr-d2-a", "en": "Chant mam, masz, ma, mamy, macie, mają then dam, dasz, da…" }
      ]},
      { "t": "Day 3 · motion", "items": [
        { "k": "irr-d3-a", "en": "Learn the four-way split: iść / chodzić / jechać / jeździć." },
        { "k": "irr-d3-b", "en": "Do the drills: motion." }
      ]},
      { "t": "Day 4 · eating and drinking", "items": [
        { "k": "irr-d4-a", "en": "Learn jem/jadłem and piję/piłem, and the plural jedzą/piją." }
      ]},
      { "t": "Day 5 · taking", "items": [
        { "k": "irr-d5-a", "en": "Learn the ą/ę swap: wziął but wzięła, wzięli." }
      ]},
      { "t": "Day 6 · knowing", "items": [
        { "k": "irr-d6-a", "en": "Learn the wiem/znam split with three sentences each." },
        { "k": "irr-d6-b", "en": "Do the drills: knowing." }
      ]},
      { "t": "Day 7 · review", "items": [
        { "k": "irr-d7-a", "en": "Do the drills: irregular-forms, all twelve." },
        { "k": "irr-d7-b", "en": "Open the verb finder and read three tables you have not seen before." }
      ]}
    ]
  },
