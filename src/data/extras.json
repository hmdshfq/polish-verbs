      { "lv": "genitive", "p": "bać się", "m": "bać się + genitive", "ex": "Boję się ciemności." },
      { "lv": "genitive", "p": "słuchać", "m": "słuchać + genitive", "ex": "Słucham muzyki." },
      { "lv": "genitive", "p": "uczyć się", "m": "uczyć się + genitive", "ex": "Uczę się polskiego." },
      { "lv": "dative", "p": "pomagać", "m": "pomagać + dative", "ex": "Pomagam mamie." },
      { "lv": "dative", "p": "dziękować", "m": "dziękować + dative", "ex": "Dziękuję panu." },
