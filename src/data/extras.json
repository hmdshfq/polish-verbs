        { "k": "rek-d1-a", "en": "Stop learning verbs alone: write szukać kluczy, pomagać mamie, czekać na autobus." },
        { "k": "rek-d1-b", "en": "Do the drills: which-case." }
      ]},
      { "t": "Day 2 · genitive", "items": [
        { "k": "rek-d2-a", "en": "Learn the genitive group: wanting, lacking, seeking, fearing, listening, learning." }
      ]},
      { "t": "Day 3 · dative", "items": [
        { "k": "rek-d3-a", "en": "Learn pomagać, dziękować, wierzyć, odpowiadać, podobać się with a dative object." }
      ]},
      { "t": "Day 4 · instrumental", "items": [
        { "k": "rek-d4-a", "en": "Practise Jestem programistą, Interesuję się historią, Kieruję firmą." }
      ]},
      { "t": "Day 5 · prepositions", "items": [
        { "k": "rek-d5-a", "en": "Learn five verb + preposition pairs whole." },
        { "k": "rek-d5-b", "en": "Do the drills: prepositions." }
      ]},
      { "t": "Day 6 · negation", "items": [
        { "k": "rek-d6-a", "en": "Turn five affirmative sentences negative and check the genitive." },
        { "k": "rek-d6-b", "en": "Do the drills: negation." }
      ]},
      { "t": "Day 7 · review", "items": [
        { "k": "rek-d7-a", "en": "Mark the flashcards and redo the ones you missed." }
      ]}
    ]
  },
